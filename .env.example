# Copy to .env.local for development. Never commit .env.local.
# On Vercel, add the same names under Project Settings > Environment Variables.

# --- Shopify store -----------------------------------------------------------
# The store's permanent domain (not the custom domain).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Private access token from the Headless sales channel. Server-only. Preferred.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Public access token from the same screen. Used only if no private token is set.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional. Leave empty to use the version this release was tested with (2026-04).
SHOPIFY_API_VERSION=

# Set to "true" to run the bundled demo catalog instead of a Shopify store.
# With no credentials, development uses the demo catalog automatically;
# production builds refuse to start unless this is set explicitly.
SHOPIFY_USE_MOCK=

# --- Site --------------------------------------------------------------------
# Public URL of this deployment, no trailing slash. Used for canonical URLs,
# the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Overrides the preset in config/theme.config.ts: organic | luxury | minimal
THEME=

# --- Customer accounts (optional) ---------------------------------------------
# The number in https://shopify.com/NUMBER/account. Shows the account icon.
SHOPIFY_SHOP_ID=
# Use instead of the shop id when the store has its own account domain.
SHOPIFY_ACCOUNT_URL=

# --- Analytics (optional). A tracker with no id never loads. -------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Forms (optional). https:// webhook URLs that receive submissions. ---------
# Without these, the live site hides the newsletter and contact forms.
NEWSLETTER_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
